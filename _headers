# Cache/security header rules (copied into dist/ by tools/minify.js).
# Honored by Cloudflare Pages and Workers Assets; a NO-OP on GitHub Pages (axiom's
# own deploy) — this file is the TEMPLATE the Axiom-based projects inherit.
#
# The stale-deploy contract (see docs/patterns/stale-deploy-prevention.md):
#   1. HTML is never cached (no-store), so a new deploy reaches everyone immediately.
#   2. tools/minify.js stamps ?v=BUILD_ID onto EVERY module URL — relative imports,
#      resolved import-map aliases (@state, @core/*, ...), lazy-route paths, entry
#      <script> tags, and stylesheets. Fresh HTML + per-deploy URLs = no stale window.
#
# CF Pages gotcha (verified live 2026-06-08 on a downstream project): Pages
# CONCATENATES Cache-Control across ALL matching rules — the specific rule does NOT
# override /* — and no-store wins the merge. So with the /* no-store below, modules
# re-download per full page load on Pages. That's the accepted trade for a small
# module graph with no service worker. Alternatives when the graph gets big: a
# versioned network-first SW, or Workers Assets, where the code rules below give
# ETag 304s.

# Security headers + no-store for ALL HTML. no-store on /* is REQUIRED: deep
# SPA-fallback routes (e.g. /dashboard) serve index.html but match only this
# catch-all — without it they cache a STALE import map while fresh ?v=-busted
# modules load → intermittent "Failed to resolve module specifier" until a
# hard refresh.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-store, must-revalidate

/
  Cache-Control: no-store, must-revalidate
/index.html
  Cache-Control: no-store, must-revalidate

# Code — revalidate every load (cheap 304 via ETag). NEVER immutable: modules are
# versioned by QUERY, and Cloudflare serves by path, ignoring it — mid-deploy a
# browser can get OLD bytes for a NEW ?v= url, and immutable pins them for a year:
# two module graphs, two auth singletons (daystra's 2026-09-12 login outage).
# On CF Pages the /* no-store concatenation wins anyway (see header note).
# Guarded by tools/headers.test.js.
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/app-routes.js
  Cache-Control: public, max-age=0, must-revalidate
/core/*
  Cache-Control: public, max-age=0, must-revalidate
/shared/*
  Cache-Control: public, max-age=0, must-revalidate
/features/*
  Cache-Control: public, max-age=0, must-revalidate

# Static media (models/textures/audio) — renamed-on-change BY FILENAME (never a
# query string: queries confuse extension-based loader selection, see a sibling's
# asset-url.js), so cache long.
/assets/*
  Cache-Control: public, max-age=604800, must-revalidate
