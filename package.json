{
  "name": "project-axiom",
  "version": "1.0.42",
  "description": "High-performance, zero-build web architecture.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js",
    "dev": "browser-sync start --server --files 'src/**/*' --single --no-notify",
    "build": "node tools/motion-gate.js && node tools/minify.js",
    "feature": "node tools/create-feature.js",
    "check-pwa": "node tools/check-pwa.js",
    "verify-dist": "node tools/verify-dist.js",
    "test:tools": "node --test 'tools/**/*.test.js'",
    "test:core": "node --import ./tests/helpers/setup.js --test 'tests/**/*.test.js'",
    "test": "npm run test:tools && npm run test:core",
    "lint": "eslint src tools tests",
    "lint:motion": "node tools/motion-gate.js",
    "types": "node tools/types.js",
    "types:check": "node tools/types.js --check",
    "e2e": "playwright test",
    "weigh": "node tools/weigh.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "browser-sync": "^3.0.0",
    "csso": "^5.0.5",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "terser": "^5.46.0",
    "typescript": "6.0.3"
  }
}
