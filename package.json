{
  "name": "project-axiom",
  "version": "1.0.42",
  "description": "High-performance, zero-build web architecture.",
  "type": "module",
  "scripts": {
    "start": "npx serve -s .",
    "dev": "browser-sync start --server --files 'src/**/*' --single --no-notify",
    "build": "node tools/motion-gate.js && node tools/minify.js",
    "feature": "node tools/create-feature.js",
    "check-pwa": "node tools/check-pwa.js",
    "verify-dist": "node tools/verify-dist.js",
    "test:tools": "node --test 'tools/**/*.test.js'",
    "lint": "eslint src tools",
    "lint:motion": "node tools/motion-gate.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "browser-sync": "^3.0.0",
    "csso": "^5.0.5",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "terser": "^5.46.0"
  }
}
