# --- Axiom: System Junk ---
.DS_Store
Thumbs.db
.cache/
.tmp/
*.log
*.swp

# --- Node & Dependencies ---
# node_modules is dev-only and never touches the repo.
# package-lock.json IS tracked, deliberately: the deploy workflow runs `npm ci`,
# which cannot resolve without it, and actions/setup-node's npm cache keys off
# it. Ignoring it here while gating CI on `npm ci` made every deploy fail at
# Setup Node ("Dependencies lock file is not found"). Dev deps still ship to
# nobody — the lockfile pins the TOOLCHAIN, not the runtime.
node_modules/
npm-debug.log*

# --- IDEs & Environments ---
.vscode/
.idea/
.env
.env.local

# --- Build Output ---
dist/

# --- Project Specific ---
# If your feature tool generates temp files
tools/.temp/

# --- Agent Tooling ---
# Per-machine session transcripts from rift; regenerable and machine-local,
# so they never belong in the tree.
.rift/